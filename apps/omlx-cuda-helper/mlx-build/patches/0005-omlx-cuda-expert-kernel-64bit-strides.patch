The sorted expert kernel (patch 0002) built its batch strides in 32 bits, so the offset of an expert
wrapped once a bank held more than 2^32 weights (for example 384 experts x 2304 x 5120): the last
experts read other experts' weights. The stock kernels use 64-bit strides; do the same.

diff --git a/mlx/backend/cuda/device/qmm_sm80.cuh b/mlx/backend/cuda/device/qmm_sm80.cuh
index a9f9bbf98..6f67f95da 100644
--- a/mlx/backend/cuda/device/qmm_sm80.cuh
+++ b/mlx/backend/cuda/device/qmm_sm80.cuh
@@ -514,9 +514,10 @@ void qmm_sm80_expert_kernel(
   }
 
   auto cta_tiler = CtaTiler{};
-  auto dA = make_stride(k, Int<1>{}, m * k);
-  auto dB = make_stride(k, Int<1>{}, n * k);
-  auto dC = make_stride(n, Int<1>{}, m * n);
+  // 64-bit batch strides: an expert bank can hold more than 2^32 weights.
+  auto dA = make_stride(k, Int<1>{}, int64_t(m) * k);
+  auto dB = make_stride(k, Int<1>{}, int64_t(n) * k);
+  auto dC = make_stride(n, Int<1>{}, int64_t(m) * n);
   auto S_layout = make_scales_layout<GroupSize>(n, k, group_count);
 
   Tensor mA = make_tensor(make_gmem_ptr(A), make_shape(m, k, 1), dA)(_,_,0);
