    "performance.memory.idle_timeout.sub" : {
      "comment" : "Sublabel for idle timeout",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server-wide auto-unload after N seconds idle. Empty or 0 = disabled. Minimum 60."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascio automatico, per tutto il server, dopo N secondi di inattività. Vuoto o 0 = disattivato. Minimo 60."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автовыгрузка на уровне сервера после N секунд простоя. Пусто или 0 = отключено. Минимум 60."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器范围的空闲 N 秒后自动卸载。空或 0 = 禁用。最小值 60。"
          }
        }
      }
    },
