        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить все файлы SSD-кэша? Загруженные модели перестроят KV-кэш при следующем префилле."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "清除全部 SSD 缓存文件？已加载的模型将在下次预填充时重建其 KV 缓存。",
            "state": "translated"
          }
        }
      }
