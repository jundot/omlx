          }
        }
      }
    },
    "welcome.setup.local.body" : {
      "comment" : "Body for the local server setup card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oMLX binds to 127.0.0.1 on first run, so clients on this Mac can use it without exposing the server to your network."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al primo avvio oMLX si collega a 127.0.0.1, così i client su questo Mac possono usarlo senza esporre il server sulla rete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При первом запуске oMLX привязывается к 127.0.0.1, поэтому клиенты на этом Mac могут использовать его без публикации сервера в сеть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oMLX 首次运行时绑定 127.0.0.1，因此本机上的客户端可以使用它，而不会将服务器暴露给网络。"
          }
        }
      }
    },
