      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preflight prefill memory before kicking the engine. Drops requests that would OOM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять память для префилла перед запуском движка. Отбрасывает запросы, которые привели бы к OOM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "启动引擎前预检查预填充内存。拒绝会导致内存不足（OOM）的请求。",
            "state": "translated"
          }
