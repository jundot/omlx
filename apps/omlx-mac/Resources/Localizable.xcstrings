    "quant.about.mixed_precision.title" : {
      "comment" : "Section heading in the expanded About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oQ and oQe: MLX-native mixed precision"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oQ e oQe: precisione mista nativa per MLX"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oQ и oQe: смешанная точность нативно для MLX"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oQ 和 oQe：MLX 原生混合精度"
          }
