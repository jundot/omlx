        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистить все файлы SSD-кэша? Загруженные модели перестроят KV-кэш при следующем префилле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除所有 SSD 缓存文件？已加载的模型将在下次预填充时重建 KV 缓存。"
