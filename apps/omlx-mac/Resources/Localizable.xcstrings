{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.button.reset_defaults" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset Defaults"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina predefiniti"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값으로 초기화"
          }
        }
      }
    },
    "settings.reset_defaults.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore default values. Paths and API keys are kept. Click Apply to save."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina i valori predefiniti. Percorsi e chiavi API vengono mantenuti. Fai clic su Applica per salvare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값을 불러옵니다. 경로와 API 키는 유지됩니다. Apply를 눌러 저장하세요."
          }
        }
      }
    },
    "settings.reset_defaults.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings Reset"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni ripristinate"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 초기화"
          }
        }
      }
    },
    "settings.reset_defaults.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings have been reset to defaults. Click Apply to save the changes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni sono state riportate ai valori predefiniti. Fai clic su Applica per salvare le modifiche."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정값을 초기화했습니다. Apply를 눌러야 저장됩니다."
          }
        }
      }
    },
