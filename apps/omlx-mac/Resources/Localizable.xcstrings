    "status.runtime_cache.subblock_note" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: Sub-block Cache means requests below one full block (for example <1024 tokens on some models) are cached in memory/paged cache but are not counted as indexed SSD blocks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Cache sotto-blocco indica che le richieste inferiori a un blocco intero (ad esempio <1024 token su alcuni modelli) vengono messe in cache in memoria/nella cache paginata, ma non vengono conteggiate come blocchi SSD indicizzati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注：子块缓存指未达一个完整块的请求（例如某些模型上 <1024 Token）被缓存在 RAM/分页缓存中，但不计入已索引的 SSD 块。"
          }
        }
      }
    },
