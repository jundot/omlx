      }
    },
    "quant.about.oqe.step.experts.body" : {
      "comment" : "oQe imatrix step body in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For MoE SwitchLinear layers, oQe records one importance vector per expert using the router-selected expert indices, so inactive or rarely active experts are visible in the coverage report."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i layer MoE SwitchLinear, oQe registra un vettore di importanza per ogni esperto usando gli indici degli esperti selezionati dal router, così gli esperti inattivi o raramente attivi sono visibili nel report di copertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для слоёв MoE SwitchLinear oQe записывает отдельный вектор важности для каждого эксперта, используя выбранные роутером индексы экспертов. Поэтому неактивные или редко активные эксперты видны в отчёте о покрытии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于 MoE SwitchLinear 层，oQe 使用路由器选择的专家索引为每个专家记录一个重要性向量，因此不活跃或很少活跃的专家在覆盖报告中可见。"
          }
        }
      }
    },
    "quant.about.oqe.step.adapt.title" : {
      "comment" : "oQe imatrix step title in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapt sample count."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta il numero di campioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адаптировать число примеров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应样本数。"
          }
        }
      }
    },
    "quant.about.oqe.step.adapt.body" : {
      "comment" : "oQe imatrix step body in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibration starts from the requested sample count and can continue up to the adaptive maximum when MoE expert coverage is not sufficient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calibrazione parte dal numero di campioni richiesto e può proseguire fino al massimo adattivo quando la copertura degli esperti MoE non è sufficiente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калибровка начинается с заданного числа примеров и может продолжаться до адаптивного максимума, если покрытие MoE-экспертов недостаточно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校准从请求的样本数开始，当 MoE 专家覆盖不足时，可以继续到自适应最大值。"
          }
        }
      }
    },
    "quant.about.oqe.step.weight.title" : {
      "comment" : "oQe imatrix step title in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight the quantization error."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesa l'errore di quantizzazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Взвесить ошибку квантования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对量化误差加权。"
          }
        }
      }
    },
    "quant.about.oqe.step.weight.body" : {
      "comment" : "oQe imatrix step body in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During affine quantization, oQe chooses scale/bias candidates by minimizing sum(importance * (weight - dequantized_weight)^2), not plain unweighted MSE."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la quantizzazione affine, oQe sceglie i candidati scale/bias minimizzando sum(importance * (weight - dequantized_weight)^2), anziché il semplice MSE non pesato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время аффинного квантования oQe выбирает кандидаты масштаба/смещения, минимизируя sum(importance * (weight - dequantized_weight)^2), а не обычную невзвешенную MSE."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在仿射量化期间，oQe 通过最小化 sum(importance * (weight - dequantized_weight)^2) 来选择 scale/bias 候选，而非普通的未加权 MSE。"
          }
        }
      }
    },
    "quant.about.oqe.fallback" : {
      "comment" : "Footnote under the imatrix steps in the About oQ card",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a tensor has no matching imatrix entry, the default behavior is to fall back to standard oQ for that tensor. Enable strict coverage to fail instead."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se un tensore non ha una voce imatrix corrispondente, per impostazione predefinita viene usato oQ standard come fallback per quel tensore. Attiva la copertura rigorosa per generare invece un errore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если для тензора нет подходящей записи imatrix, по умолчанию для этого тензора используется стандартный oQ. Включите строгое покрытие, чтобы вместо этого завершать работу с ошибкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果张量没有匹配的 imatrix 条目，默认行为是对该张量回退到标准 oQ。启用严格覆盖以改为失败。"
          }
        }
      }
    },
