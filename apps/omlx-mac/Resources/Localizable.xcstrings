    "status.confirm.clear_hot" : {
      "comment" : "Confirmation dialog title for clearing the hot (memory) KV cache",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clear the in-memory KV cache for all loaded models? Subsequent requests will re-fault from SSD or recompute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svuotare la cache KV in memoria per tutti i modelli caricati? Le richieste successive ricaricheranno i dati dall'SSD o li ricalcoleranno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистить KV-кэш в памяти для всех загруженных моделей? Следующие запросы снова загрузят данные с SSD или пересчитают кэш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除所有已加载模型的内存 KV 缓存？后续请求将从 SSD 重新加载或重新计算。"
          }
        }
      }
    },
    "status.confirm.clear_session" : {
      "comment" : "Confirmation dialog title for clearing session stats",
