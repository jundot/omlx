    "performance.memory.guard_tier.aggressive.sub" : {
      "comment" : "Description for aggressive memory guard tier",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Leaves only 2% of RAM (1.5-4 GB) for macOS and may compress other apps' memory, so oMLX can use nearly all RAM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia a macOS solo il 2% della RAM (1.5-4 GB) e può comprimere la memoria delle altre app, così oMLX può usare quasi tutta la RAM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет macOS только 2% RAM (1,5-4 ГБ) и может сжимать память других приложений, чтобы oMLX использовал почти всю RAM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只为 macOS 保留 2% 内存（1.5-4 GB），并可压缩其他应用的内存，让 oMLX 几乎可以使用全部内存。"
          }
        }
      }
    },
