    "appearance.row.menubar_icon.sub": {
      "comment": "Appearance row sublabel for the menu bar icon restore action",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the oMLX icon back if it was removed from the menu bar. Separate from the Dock icon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть значок oMLX, если он был удалён из строки меню. Не связано со значком в Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "如果 oMLX 图标已从菜单栏移除，可在此恢复。与 Dock 图标相互独立。",
            "state": "translated"
          }
        }
      }
    },
