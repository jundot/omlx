    "menubar.alert.port_in_use.omlx" : {
      "comment" : "Port-conflict alert body when the conflicting process is another oMLX instance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another oMLX server is already running on this port (%@). Stop it before starting a new instance, or change the port in Settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro server oMLX è già in esecuzione su questa porta (%@). Arrestalo prima di avviare una nuova istanza oppure cambia la porta in Impostazioni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом порту (%@) уже запущен другой сервер oMLX. Остановите его перед запуском нового экземпляра или измените порт в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 oMLX 服务器已在该端口上运行（%@）。请先停止它再启动新实例，或在设置中更改端口。"
          }
        }
      }
    },
    "menubar.alert.port_in_use.other" : {
      "comment" : "Port-conflict alert body when an unrelated process owns the port",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another process (%1$@) is listening on port %2$@. Choose a different port in Settings or terminate that process."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro processo (%1$@) è in ascolto sulla porta %2$@. Scegli una porta diversa in Impostazioni oppure termina quel processo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой процесс (%1$@) слушает порт %2$@. Выберите другой порт в настройках или завершите этот процесс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个进程（%1$@）正在监听端口 %2$@。请在设置中选择其他端口或终止该进程。"
          }
        }
      }
    },
    "menubar.alert.port_in_use.title" : {
      "comment" : "Title of the port-conflict alert; placeholder is the port number (plain integer, no grouping)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Port %@ is in use."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta %@ è in uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт %@ занят."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口 %@ 已被占用。"
          }
        }
      }
    },
    "menubar.alert.server_failed.access_hint" : {
      "comment" : "Hint shown when the server failure log suggests a model directory permission problem",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check that the configured model directory is mounted and readable. If it is on an external or protected location, grant oMLX access in macOS Privacy & Security settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica che la directory dei modelli configurata sia montata e leggibile. Se si trova in una posizione esterna o protetta, consenti l'accesso a oMLX nelle impostazioni Privacy e sicurezza di macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте, что настроенный каталог моделей подключен и доступен для чтения. Если он находится на внешнем или защищенном диске, выдайте oMLX доступ в настройках macOS «Конфиденциальность и безопасность»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认已配置的模型目录已挂载且可读。如果位于外部或受保护的位置，请在 macOS 隐私与安全性设置中授予 oMLX 访问权限。"
          }
        }
      }
    },
    "menubar.alert.server_failed.body" : {
      "comment" : "Introductory body text for the server startup failure alert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The server process exited before it became healthy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il processo del server è terminato prima di diventare operativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесс сервера завершился до того, как стал исправным."
          }
