    "server.advanced.sse_keepalive.sub" : {
      "comment" : "Sublabel describing the SSE keep-alive mode options",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the server keeps long-lived SSE streams open. \"chunk\" emits an empty data line, \"comment\" emits `: ping`, \"off\" disables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determina come il server tiene aperti gli stream SSE di lunga durata. \"chunk\" invia una riga data vuota, \"comment\" invia `: ping`, \"off\" disattiva il keep-alive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как сервер удерживает открытыми долгоживущие SSE-потоки. \"chunk\" отправляет пустую data-строку, \"comment\" отправляет `: ping`, \"off\" отключает режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器如何保持长连接 SSE 流打开。'chunk' 发送空数据行，'comment' 发送 ': ping'，'off' 禁用。"
          }
        }
      }
    },
