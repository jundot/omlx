    "server.advanced.sse_keepalive.sub": {
      "comment": "Sublabel describing the SSE keep-alive mode options",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the server keeps long-lived SSE streams open. \"chunk\" emits an empty data line, \"comment\" emits `: ping`, \"off\" disables."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как сервер удерживает открытыми долгоживущие SSE-потоки. \"chunk\" отправляет пустую data-строку, \"comment\" отправляет `: ping`, \"off\" отключает режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "服务端如何保持长期 SSE流开启。\"chunk\" 发出一个空数据行，\"comment\" 发出 `: ping`，\"off\" 禁用保活。",
            "state": "translated"
          }
        }
      }
    },
