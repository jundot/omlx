    "performance.scheduler.prefill_priority.sub" : {
      "comment" : "Sublabel for the prefill priority segmented control",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max Context trades prefill speed for larger prompts under memory pressure; Speed keeps full prefill speed and rejects prompts that would not fit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contesto massimo accetta prompt più grandi con un prefill più lento; Velocità rifiuta i prompt troppo grandi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大上下文在内存压力下以预填充速度换取更大的提示；速度保持完整预填充速度并拒绝不适合的提示。"
          }
        }
      }
    },
