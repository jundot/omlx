    "bench.context.warning.body" : {
      "comment" : "Body of the warning callout above the Context Bench start button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This benchmark can take a long time — verification prefills a real prompt at the measured size, which may take many minutes for large models. All loaded models are unloaded when it starts, interrupting active requests. When it finishes, the result is automatically applied to the model's Context Window setting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo benchmark può richiedere molto tempo — il prefill di verifica esegue un prompt reale della dimensione misurata e, con modelli grandi, può durare molti minuti. All'avvio tutti i modelli caricati vengono rilasciati e le richieste attive vengono interrotte. Al termine, il risultato viene applicato automaticamente all'impostazione Finestra di contesto del modello."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此基准测试可能需要很长时间 — 验证会在测量大小处预填充真实提示，对于大型模型可能需要很多分钟。开始时所有已加载的模型都会被卸载，中断活动请求。完成后，结果会自动应用到模型的上下文窗口设置。"
          }
        }
      }
    },
