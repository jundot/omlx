    "settings.experimental.k2_ane.sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use ANE for dense and shared-expert MLP prefill. Attention and decode stay on GPU. Changes take effect after reload."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l'ANE per il prefill degli MLP densi e degli esperti condivisi. Attenzione e decodifica restano su GPU. Le modifiche hanno effetto dopo il ricaricamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует ANE для предзаполнения плотных MLP и общих экспертов. Внимание и декодирование остаются на GPU. Применяется после перезагрузки модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ANE 处理稠密与共享专家 MLP 的预填充。注意力和解码仍在 GPU 上。重新加载后生效。"
          }
        }
      }
    },
    "settings.experimental.k2_ane.dense" : {
      "extractionState" : "manual",
      "localizations" : {
