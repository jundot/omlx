    "settings.k2.thinking_hint" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 uses reasoning effort. Use Thinking Budget to limit reasoning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 usa il livello di ragionamento. Per limitare il ragionamento usa Budget di ragionamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 は推論の強度を使用します。「Thinking Budget」で推論を制限できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "K2는 추론 강도를 사용합니다. Thinking Budget으로 추론을 제한하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 использует уровень рассуждения. Используйте «Бюджет thinking», чтобы ограничить рассуждение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 使用推理强度。可通过“思考预算”限制推理。"
