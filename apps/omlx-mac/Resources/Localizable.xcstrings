      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Context trades prefill speed for larger prompts under memory pressure; Speed keeps full prefill speed and rejects prompts that would not fit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "“最大上下文”会在内存压力下以预填充速度换取更大的提示词容量；“速度”保持全速预填充，并拒绝放不下的提示词。",
            "state": "translated"
          }
        }
      }
