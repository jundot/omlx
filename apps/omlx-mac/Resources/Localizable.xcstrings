    "performance.memory.prefill_guard.sub" : {
      "comment" : "Sublabel for prefill memory guard",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preflight prefill memory before kicking the engine. Drops requests that would OOM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la memoria richiesta dal prefill prima di avviare il motore. Scarta le richieste che esaurirebbero la memoria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверять память для префилла перед запуском движка. Отбрасывает запросы, которые привели бы к OOM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动引擎前预检预填充内存。丢弃会导致 OOM 的请求。"
          }
        }
      }
    },
