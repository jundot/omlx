    "menubar.alert.port_in_use.omlx": {
      "comment": "Port-conflict alert body when the conflicting process is another oMLX instance",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Another oMLX server is already running on this port (%@). Stop it before starting a new instance, or change the port in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом порту (%@) уже запущен другой сервер oMLX. Остановите его перед запуском нового экземпляра или измените порт в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "另一个 oMLX 服务器已在此端口（%@）上运行。请先停止它再启动新实例，或在设置中更换端口。",
            "state": "translated"
          }
        }
      }
    },
    "menubar.alert.port_in_use.other": {
      "comment": "Port-conflict alert body when an unrelated process owns the port",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Another process (%1$@) is listening on port %2$@. Choose a different port in Settings or terminate that process."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой процесс (%1$@) слушает порт %2$@. Выберите другой порт в настройках или завершите этот процесс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "value": "另一个进程（%1$@）正在监听端口 %2$@。请在设置中选择其他端口，或终止该进程。",
            "state": "translated"
          }
        }
      }
    },
    "menubar.alert.port_in_use.title": {
      "comment": "Title of the port-conflict alert; placeholder is the port number (plain integer, no grouping)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Port %@ is in use."
