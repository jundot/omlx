      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear all SSD cache files? Loaded models will rebuild their KV cache on next prefill."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare tutti i file della cache SSD? I modelli caricati ricostruiranno la cache KV al prossimo prefill."
